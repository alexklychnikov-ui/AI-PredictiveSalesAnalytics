APP_ENV=production
LOG_LEVEL=INFO

APP_DOMAIN=salesanalytics.alexklyvibe.ru
ACME_EMAIL=admin@alexklyvibe.ru

POSTGRES_DB=sales_analytics
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Опционально. Если пусто — URL собирается из POSTGRES_* с URL-encoding пароля.
DATABASE_URL=

BASIC_AUTH_USER=admin
# В .env для Docker Compose каждый $ в bcrypt-хэше экранируй как $$
# Пример: $$2a$$14$$...
BASIC_AUTH_PASSWORD_HASH=replace_with_caddy_hash_escaped_dollars

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=50
